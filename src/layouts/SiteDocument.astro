---
import { SiteChrome } from "../components/site/SiteChrome";
import type { SiteSection } from "../components/site/SiteNavigation";
import { sitePath } from "../components/site/paths";
import mods from "../assets/screenshots/mods-load-order.png";
import { themeStorageKey } from "../scripts/theme-preference";
import "../styles/global.css";

type Props = { readonly title: string; readonly description: string; readonly currentSection: SiteSection };
const { title, description, currentSection } = Astro.props;
const pageTitle = `${title} — Mod Conductor`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const previewImageUrl = new URL(sitePath(`_astro/${mods.src.slice(mods.src.lastIndexOf("/") + 1)}`), Astro.site);
const previewImageAlt = "Mods and the mixed load-order view in a demonstration Skyrim profile.";
---
<!doctype html>
<html lang="en" class="scheme-light dark:scheme-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href={sitePath("assets/favicon-32.png")} />
    <link rel="icon" type="image/svg+xml" sizes="any" href={sitePath("assets/modconductor.svg")} />
    <link rel="apple-touch-icon" sizes="180x180" href={sitePath("assets/apple-touch-icon.png")} />
    {currentSection === "not-found" ? <meta name="robots" content="noindex" /> : <Fragment>
      <link rel="canonical" href={canonicalUrl} />
      <meta property="og:type" content="website" />
      <meta property="og:site_name" content="Mod Conductor" />
      <meta property="og:title" content={pageTitle} />
      <meta property="og:description" content={description} />
      <meta property="og:url" content={canonicalUrl} />
      <meta property="og:image" content={previewImageUrl} />
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content={String(mods.width)} />
      <meta property="og:image:height" content={String(mods.height)} />
      <meta property="og:image:alt" content={previewImageAlt} />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={pageTitle} />
      <meta name="twitter:description" content={description} />
      <meta name="twitter:image" content={previewImageUrl} />
      <meta name="twitter:image:alt" content={previewImageAlt} />
    </Fragment>}
    <script is:inline define:vars={{ themeStorageKey }}>
      const storedTheme = localStorage.getItem(themeStorageKey);
      if (storedTheme === "light" || storedTheme === "dark") {
        document.documentElement.dataset.theme = storedTheme;
      }
    </script>
    <title>{pageTitle}</title>
  </head>
  <body><SiteChrome currentSection={currentSection}><slot /></SiteChrome></body>
</html>

<script>
  import { enhanceThemeControl } from "../scripts/theme-control";
  enhanceThemeControl();
</script>
